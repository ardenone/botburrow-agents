# =============================================================================
# SEALEDSECRET TEMPLATES FOR BOTBURROW-AGENTS
# =============================================================================
#
# This file contains templates for creating SealedSecrets for botburrow-agents.
# SealedSecrets are encrypted Kubernetes secrets that can be safely committed
# to Git. They are decrypted by the SealedSecrets controller in the cluster.
#
# WORKFLOW:
#   1. Fill in the actual values in the templates below
#   2. Generate SealedSecrets using kubeseal:
#      kubeseal --format yaml < botburrow-agents-sealedsecret-templates.yml > botburrow-agents-sealedsecrets.yml
#   3. Commit the SealedSecret YAML (safe for Git)
#   4. Apply to cluster: kubectl apply -f botburrow-agents-sealedsecrets.yml
#
# PREREQUISITES:
#   - SealedSecrets controller installed in cluster
#   - kubeseal CLI installed locally
#   - Access to cluster for sealing (kubeseal needs to fetch certificate)
#
# ALTERNATIVE: Use remote sealing if cluster access is restricted:
#   kubeseal --format yaml --controller-name sealed-secrets --controller-namespace kube-system \
#     < botburrow-agents-sealedsecret-templates.yml > botburrow-agents-sealedsecrets.yml
#
# =============================================================================

# =============================================================================
# TEMPLATE: botburrow-agents-secrets
# =============================================================================
#
# Contains core application secrets for botburrow-agents.
#
# REQUIRED VALUES:
#   - HUB_API_KEY: API key for Botburrow Hub (get from Hub admin)
#   - R2_ENDPOINT: Cloudflare R2 endpoint URL
#   - R2_ACCESS_KEY: Cloudflare R2 access key ID
#   - R2_SECRET_KEY: Cloudflare R2 secret access key
#   - FORGEJO_USER: Forgejo username (default: botburrow-agents)
#   - FORGEJO_TOKEN: Forgejo personal access token (create at https://forgejo.ardenone.com)
#   - GITHUB_USER: GitHub username for external repo access
#   - GITHUB_TOKEN: GitHub personal access token with repo scope
#
# =============================================================================

---
apiVersion: v1
kind: Secret
metadata:
  name: botburrow-agents-secrets
  namespace: botburrow-agents
  labels:
    app.kubernetes.io/name: botburrow-agents
type: Opaque
stringData:
  # =============================================================================
  # HUB API ACCESS
  # =============================================================================
  # Get from botburrow-hub admin or create via Hub API
  HUB_API_KEY: "REPLACE_WITH_HUB_API_KEY"

  # =============================================================================
  # R2 STORAGE (Cloudflare R2 for agent artifacts)
  # =============================================================================
  # Get from Cloudflare R2 dashboard: https://dash.cloudflare.com/
  R2_ENDPOINT: "https://REPLACE_WITH_R2_ACCOUNT_ID.r2.cloudflarestorage.com"
  R2_ACCESS_KEY: "REPLACE_WITH_R2_ACCESS_KEY_ID"
  R2_SECRET_KEY: "REPLACE_WITH_R2_SECRET_ACCESS_KEY"

  # =============================================================================
  # GIT ACCESS - FORGEJO (Internal Git)
  # =============================================================================
  # Create token at: https://forgejo.ardenone.com/user/settings/applications
  # Required scopes: read:user, read:repository, write:repository
  FORGEJO_USER: "botburrow-agents"
  FORGEJO_TOKEN: "REPLACE_WITH_FORGEJO_PAT"

  # =============================================================================
  # GIT ACCESS - GITHUB (External repositories)
  # =============================================================================
  # Create PAT at: https://github.com/settings/tokens
  # Required scopes: repo (full control)
  GITHUB_USER: "REPLACE_WITH_GITHUB_USERNAME"
  GITHUB_TOKEN: "REPLACE_WITH_GITHUB_PAT"

# =============================================================================
# TEMPLATE: mcp-credentials
# =============================================================================
#
# Contains credentials for MCP (Model Context Protocol) servers.
#
# REQUIRED VALUES:
#   - GITHUB_PAT: GitHub PAT for MCP github server (can reuse GITHUB_TOKEN)
#   - BRAVE_API_KEY: Brave Search API key (get at https://brave.com/search/api/)
#   - ANTHROPIC_API_KEY: Anthropic API key (optional, empty when using z.ai proxy)
#
# =============================================================================

---
apiVersion: v1
kind: Secret
metadata:
  name: mcp-credentials
  namespace: botburrow-agents
  labels:
    app.kubernetes.io/name: botburrow-agents
type: Opaque
stringData:
  # =============================================================================
  # MCP SERVER CREDENTIALS
  # =============================================================================

  # GitHub MCP server - requires PAT with repo scope
  # Can reuse the same value as GITHUB_TOKEN from botburrow-agents-secrets
  GITHUB_PAT: "REPLACE_WITH_GITHUB_PAT"

  # Brave Search API key
  # Get at: https://brave.com/search/api/
  # Free tier: 2000 requests/month
  BRAVE_API_KEY: "REPLACE_WITH_BRAVE_API_KEY"

  # Anthropic API key for Claude
  # NOTE: Leave empty when using z.ai proxy (default configuration)
  # The z.ai proxy handles authentication internally
  ANTHROPIC_API_KEY: ""

# =============================================================================
# SEALING INSTRUCTIONS
# =============================================================================
#
# After filling in the values above, generate the SealedSecret:
#
#   # Method 1: Direct sealing (requires cluster access)
#   kubeseal --format yaml < botburrow-agents-sealedsecret-templates.yml \
#     > k8s/apexalgo-iad/botburrow-agents-sealedsecrets.yml
#
#   # Method 2: Remote sealing (when cluster access is restricted)
#   kubeseal --format yaml \
#     --controller-name sealed-secrets \
#     --controller-namespace kube-system \
#     < botburrow-agents-sealedsecret-templates.yml \
#     > k8s/apexalgo-iad/botburrow-agents-sealedsecrets.yml
#
#   # Method 3: With custom certificate (if using offline sealing)
#   kubeseal --format yaml \
#     --cert /path/to/sealed-secrets-cert.pem \
#     < botburrow-agents-sealedsecret-templates.yml \
#     > k8s/apexalgo-iad/botburrow-agents-sealedsecrets.yml
#
# VERIFICATION:
#   # Verify the SealedSecret is valid (do not commit if validation fails)
#   kubectl apply --dry-run=server -f k8s/apexalgo-iad/botburrow-agents-sealedsecrets.yml
#
# DEPLOYMENT:
#   # Apply the SealedSecret to cluster
#   kubectl apply -f k8s/apexalgo-iad/botburrow-agents-sealedsecrets.yml
#
#   # Verify the Secret was created
#   kubectl get secret botburrow-agents-secrets -n botburrow-agents
#   kubectl get secret mcp-credentials -n botburrow-agents
#
# SECURITY NOTES:
#   - NEVER commit the filled template with real values
#   - Only commit the .sealedsecrets.yml file generated by kubeseal
#   - Add the template to .gitignore to prevent accidental commits
#   - Rotate keys regularly (update sealedsecrets and re-apply)
#   - Use separate values for staging and production
#
# =============================================================================
